          "label": "Configuration applied",
          "type": "integration_event",
          "event": "runtime.config.applied",
          "capability": "runtime.configuration",
          "enabled": true
        },
        "intent": "keep_updated",
        "conditionTree": {
          "op": "and",
          "children": []
        },

      "config": {
        "automation_schema_version": "automation.behavior.v2",
        "triggers": [
          {
            "id": "config_applied",
            "label": "Configuration applied",
            "type": "integration_event",
            "event": "runtime.config.applied",
            "capability": "runtime.configuration",
            "enabled": true,
            "sourceRef": {
              "integrationId": "{{integrationId}}",
              "integrationKey": "{{integrationKey}}",
              "configId": "{{configId}}",
              "behaviorDeviceKey": "piphi_network_midea_ac_lan_device",
              "optionKey": "config_applied",
              "capability": "runtime.configuration"
            }
          }
        ],
        "trigger": {
